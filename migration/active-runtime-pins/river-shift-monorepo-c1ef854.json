      "sha256": "ee8b92202b31a640585d3c8b0b22f4fa25b0b39761c9cb372a17b23ded1aedc7",
      "source": "    def get_river_shift_job_by_idempotency(self, owner_uid: str, idempotency_key: str) -> dict[str, Any] | None:\n        try:\n            response = (self.client.table(\"river_shift_jobs\").select(RIVER_SHIFT_JOB_RESPONSE_COLUMNS)\n                        .eq(\"owner_uid\", owner_uid).eq(\"idempotency_key\", idempotency_key)\n                        .limit(1).execute())\n        except Exception:\n            raise PersistenceError(\"Could not check RiverShift job idempotency.\") from None\n        rows = self._data(response)\n        return rows[0] if rows else None\n"
    },
    {
      "path": "apps/api/app/persistence.py",
      "sha256": "dbaf684b996a18c812d0602c8f52d4d2c32428bccd9165f5a1b177e60f643bc1",
      "source": "    def create_river_shift_job(self, values: dict[str, Any]) -> dict[str, Any]:\n        existing = self.get_river_shift_job_by_idempotency(values[\"owner_uid\"], values[\"idempotency_key\"])\n        if existing:\n            return existing\n        try:\n            response = self.client.table(\"river_shift_jobs\").insert(values).select(RIVER_SHIFT_JOB_RESPONSE_COLUMNS).execute()\n        except Exception:\n            existing = self.get_river_shift_job_by_idempotency(values[\"owner_uid\"], values[\"idempotency_key\"])\n            if existing:\n                return existing\n            active = self.list_active_river_shift_jobs(values[\"owner_uid\"])\n            if active:\n                raise PersistenceConflictError(\"An active RiverShift job already exists for this account.\") from None\n            raise PersistenceError(\"Could not persist the RiverShift job.\") from None\n        rows = self._data(response)\n        if not rows:\n            raise PersistenceError(\"RiverShift job persistence returned no record.\")\n        return rows[0]\n"
    },
    {
      "path": "apps/api/app/persistence.py",
      "sha256": "344b26ecdb37442e33fbd45ede634d72efad58c96b8d7ce75048a9c4e63dbf21",
      "source": "    def list_river_shift_jobs(self, owner_uid: str, limit: int = 20) -> list[dict[str, Any]]:\n        try:\n            response = (\n                self.client.table(\"river_shift_jobs\")\n                .select(RIVER_SHIFT_JOB_RESPONSE_COLUMNS)\n                .eq(\"owner_uid\", owner_uid)\n                .order(\"created_at\", desc=True)\n                .limit(limit)\n                .execute()\n            )\n        except Exception:\n            raise PersistenceError(\"Could not list RiverShift jobs.\") from None\n        return self._data(response)\n"
    },
    {
      "path": "apps/api/app/persistence.py",
      "sha256": "81b8893085c1a6ce394665f26371ca77ca5bed70d49d1bc52710fb4f8c8c9e2b",
      "source": "    def list_active_river_shift_jobs(self, owner_uid: str) -> list[dict[str, Any]]:\n        try:\n            response = (\n                self.client.table(\"river_shift_jobs\")\n                .select(\"id,state,stage,created_at\")\n                .eq(\"owner_uid\", owner_uid)\n                .in_(\"state\", [\"queued\", \"dispatching\", \"running\"])\n                .order(\"created_at\", desc=True)\n                .limit(2)\n                .execute()\n            )\n        except Exception:\n            raise PersistenceError(\"Could not check active RiverShift jobs.\") from None\n        return self._data(response)\n"
    },
    {
      "path": "apps/api/app/persistence.py",
      "sha256": "1bdf4caace90491c2e662fb4864b8a27c0eda987156008e3015910f1ffa36677",
      "source": "    def get_river_shift_job(self, owner_uid: str, job_id: UUID) -> dict[str, Any] | None:\n        try:\n            response = (self.client.table(\"river_shift_jobs\").select(RIVER_SHIFT_JOB_RESPONSE_COLUMNS)\n                        .eq(\"owner_uid\", owner_uid).eq(\"id\", str(job_id)).limit(1).execute())\n        except Exception:\n            raise PersistenceError(\"Could not read the RiverShift job.\") from None\n        rows = self._data(response)\n        return rows[0] if rows else None\n"
    },
