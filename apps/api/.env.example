# development or production; production requires explicit CORS_ORIGINS.
APP_ENV=development

# Firebase Admin uses Application Default Credentials or this server-side file path.
# Never put this file's real value in frontend VITE_* variables.
# Example placeholder only; keep the real credential file outside the repository.
GOOGLE_APPLICATION_CREDENTIALS=path/to/server-side-firebase-admin-credentials.json
# Vercel only: set the full service-account JSON as a hosting secret instead of the path above.
# Do not put a real credential value in this file or in any frontend variable.
# FIREBASE_SERVICE_ACCOUNT_JSON=replace-with-hosting-provided-service-account-json

# Optional; defaults to localhost development origins.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Hosting platforms provide this; local development defaults to 8000.
PORT=8000

# Read-only ASF metadata search is enabled by default; set false to disable it.
ASF_CATALOG_ENABLED=true
ASF_SEARCH_URL=https://api.daac.asf.alaska.edu/services/search/param
ASF_MAX_RESULTS=2000
ASF_TIMEOUT_SECONDS=20

# Server-only Supabase persistence for SARGuardian-Monorepo project qbmhpdprvxssqinnommz. Never expose the key to Frontend/.
SUPABASE_URL=https://qbmhpdprvxssqinnommz.supabase.co
# Keep this variable name for the server-only key. It may contain a modern
# sb_secret_... key or a legacy service_role JWT key.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_CREATE_IN_DASHBOARD_AND_PASTE_LOCALLY
PREFLIGHT_TTL_SECONDS=86400

# GitHub Actions science dispatch. These remain server-only values.
DISPLACEMENT_ACTIONS_ENABLED=false
GITHUB_ACTIONS_TOKEN=github_actions_write_token
GITHUB_ACTIONS_REPOSITORY=owner/SARGuardian_Dynamic
GITHUB_ACTIONS_WORKFLOW=sarguardian-displacement.yml
GITHUB_ACTIONS_REF=main
DISPLACEMENT_CALLBACK_SECRET=replace_with_long_random_hmac_secret
PUBLIC_API_URL=https://api.example.org

# Known Place uses two separate workflows: generic two-polygon analysis and
# the author-exact P05023 research reproduction. Keep these independently
# configurable. Defaults preserve the existing Backend dispatcher until an
# explicit, tested Monorepo workflow cutover.
KNOWN_PLACE_GITHUB_ACTIONS_REPOSITORY=moshiour0/SARGuardian-backend
KNOWN_PLACE_GITHUB_ACTIONS_WORKFLOW=know-place-aoi-dispatcher.yml
KNOWN_PLACE_GITHUB_ACTIONS_REF=main
# Optional future Monorepo generic-workflow cutover. Do not set until the
# dispatcher is merged to default branch and PAT/Actions secrets are prepared:
# KNOWN_PLACE_GITHUB_ACTIONS_REPOSITORY=moshiour0/SARGuardian-Monorepo
# KNOWN_PLACE_GITHUB_ACTIONS_WORKFLOW=know-place-aoi-dispatcher.yml
# KNOWN_PLACE_GITHUB_ACTIONS_REF=main
KNOWN_PLACE_PAPER_GITHUB_ACTIONS_REPOSITORY=moshiour0/SARGuardian-backend
KNOWN_PLACE_PAPER_GITHUB_ACTIONS_WORKFLOW=know-place-paper-reproduction-dispatcher.yml
KNOWN_PLACE_PAPER_GITHUB_ACTIONS_REF=main

# River Shift is an independent NISAR GCOV engine. Keep this disabled until
# the Dynamic API, the matching Supabase migration and backend Actions worker
# are installed. These are server-only values; never expose them as VITE_*.
RIVERSHIFT_ACTIONS_ENABLED=false
RIVERSHIFT_GITHUB_ACTIONS_TOKEN=
RIVERSHIFT_GITHUB_ACTIONS_REPOSITORY=moshiour0/SARGuardian-backend
RIVERSHIFT_GITHUB_ACTIONS_WORKFLOW=river-shift-gcov-process.yml
RIVERSHIFT_GITHUB_ACTIONS_REF=main
RIVERSHIFT_CALLBACK_SECRET=
RIVERSHIFT_PUBLIC_API_URL=https://api.example.org
